    {
      "name": "2. Floods (Người dùng & Báo cáo cộng đồng)",
      "item": [
        {
          "name": "TC-04: Lấy danh sách điểm ngập đang hoạt động (GET /api/v1/floods)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/floods",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "floods"]
            },
            "description": "Truy vấn các điểm ngập còn hiệu lực (chưa hết hạn) từ MySQL để hiển thị lên bản đồ."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Thời gian phản hồi < 200ms (Spatial Query tối ưu)', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(200);",
                  "});",
                  "pm.test('Dữ liệu trả về dạng mảng', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(Array.isArray(json)).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-05: Gửi báo cáo ngập hợp lệ (POST /api/v1/floods)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Đường Nguyễn Hữu Cảnh, Bình Thạnh\",\n  \"description\": \"Nước ngập nửa bánh xe đoạn gần chân cầu\",\n  \"latitude\": 10.7932,\n  \"longitude\": 106.7214,\n  \"severity_level\": \"medium\",\n  \"water_depth_cm\": 30,\n  \"radius_meters\": 50\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/floods",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "floods"]
            },
            "description": "Người dân gửi điểm ngập mới trong phạm vi TP.HCM."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201 Created hoặc 200 OK', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "pm.test('Thời gian phản hồi < 200ms', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(200);",
                  "});",
                  "var json = pm.response.json();",
                  "if (json.id) {",
                  "    pm.collectionVariables.set('test_flood_id', json.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-06: Báo cáo ngập ngoài phạm vi TPHCM - Bị từ chối (POST /api/v1/floods)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Điểm ngập ngoài tỉnh (Hà Nội)\",\n  \"description\": \"Test tọa độ ngoài TP.HCM\",\n  \"latitude\": 21.0285,\n  \"longitude\": 105.8542,\n  \"severity_level\": \"high\",\n  \"water_depth_cm\": 50,\n  \"radius_meters\": 50\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/floods",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "floods"]
            },
            "description": "Kiểm tra tính hợp lệ dữ liệu (Negative Test): Tọa độ nằm ngoài TP.HCM phải trả về 422 Unprocessable Entity."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 422 Unprocessable Entity (Bảo vệ dữ liệu)', function () {",
                  "    pm.response.to.have.status(422);",
                  "});",
                  "pm.test('Thời gian phản hồi < 200ms', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(200);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
