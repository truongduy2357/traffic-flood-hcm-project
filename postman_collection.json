{
  "info": {
    "_postman_id": "traffic-flood-hcm-test-suite-sprint4",
    "name": "Traffic & Flood Warning HCM - API Test Suite (Sprint 4)",
    "description": "Bộ kiểm thử tự động toàn bộ API hệ thống Cảnh báo Kẹt xe & Ngập lụt TPHCM trên Postman / Swagger UI.\nĐảm bảo tiêu chuẩn thời gian phản hồi < 200ms theo đặc tả SRS.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    },
    {
      "key": "test_flood_id",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. System & Health Check",
      "item": [
        {
          "name": "TC-01: Health Check (GET /health)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": ["{{base_url}}"],
              "path": ["health"]
            },
            "description": "Kiểm tra trạng thái hoạt động của server FastAPI và kết nối CSDL."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Thời gian phản hồi < 200ms', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(200);",
                  "});",
                  "pm.test('Kiểm tra trạng thái hệ thống', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.status).to.be.oneOf(['healthy', 'ok', 'degraded']);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-02: Public Config (GET /api/v1/config)",
          "request": {
            "method": "GET",
            "header": [],
