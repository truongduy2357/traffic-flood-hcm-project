                  "    pm.expect(pm.response.responseTime).to.be.below(200);",
                  "});",
                  "pm.test('Cung cấp đầy đủ ranh giới TPHCM', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property('hcm_bounds');",
                  "});"
                ]
              }
            }
          ]
