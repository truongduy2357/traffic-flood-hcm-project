    {
      "name": "3. Routing (Né ngập & Spatial Query)",
      "item": [
        {
          "name": "TC-07: Kiểm tra lộ trình né ngập qua Polyline (POST /api/v1/routes/check-flood)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"encoded_polyline\": \"_p~iF~ps|U_ulLnnqC_mqNvxq`@\",\n  \"buffer_meters\": 50\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/routes/check-flood",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "routes", "check-flood"]
            },
            "description": "Giải mã chuỗi Polyline LINESTRING và kiểm tra giao cắt không gian với các điểm ngập (ST_Intersects / ST_Distance_Sphere)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Thời gian truy vấn không gian < 200ms (Nhờ MySQL Spatial Index R-Tree)', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(200);",
                  "});",
                  "pm.test('Phản hồi có trường has_flood', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property('has_flood');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-08: Kiểm tra lộ trình qua danh sách tọa độ Points (POST /api/v1/routes/check-flood)",
