# ==============================================================================
# HỆ THỐNG BẢN ĐỒ CẢNH BÁO KẸT XE & NGẬP LỤT TP.HCM (TRAFFIC & FLOOD MAP)
# File cấu hình môi trường mẫu (.env.example)
# Sao chép file này thành .env và điền các thông tin phù hợp trước khi chạy hệ thống
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CƠ SỞ DỮ LIỆU MYSQL 8.0+ (DATABASE CONFIGURATION)
# ------------------------------------------------------------------------------
# Chuỗi kết nối SQLAlchemy hỗ trợ PyMySQL và Spatial Data (MySQL 8.0+)
# Cú pháp: mysql+pymysql://<username>:<password>@<host>:<port>/<database_name>?charset=utf8mb4
DATABASE_URL=mysql+pymysql://root:your_mysql_password_here@localhost:3306/flood_warning_db?charset=utf8mb4

# Cấu hình chi tiết kết nối (dùng cho script migration/tạo database)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=flood_warning_db

# Hệ quy chiếu không gian GPS WGS 84 (Spatial Reference System Identifier)
SPATIAL_SRID=4326

# ------------------------------------------------------------------------------
# 2. BẢO MẬT & XÁC THỰC (SECURITY & AUTHENTICATION)
# ------------------------------------------------------------------------------
# Khóa bí mật dùng cho mã hóa JWT, ký token và bảo mật phiên làm việc (nên tạo chuỗi ngẫu nhiên 64 ký tự)
SECRET_KEY=your_super_secret_key_change_this_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ------------------------------------------------------------------------------
# 3. GOOGLE MAPS PLATFORM API
# ------------------------------------------------------------------------------
# API Key sử dụng cho Maps JavaScript API, Places API, Directions API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ------------------------------------------------------------------------------
# 4. CẤU HÌNH HỆ THỐNG FASTAPI SERVER (APPLICATION CONFIGURATION)
# ------------------------------------------------------------------------------
APP_NAME=Hệ thống Bản đồ Cảnh báo Kẹt xe và Ngập lụt TPHCM
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# CORS Origins (danh sách domain Frontend được phép gọi API)
CORS_ORIGINS=["http://localhost", "http://localhost:8000", "http://127.0.0.1:5500", "http://localhost:3000", "http://127.0.0.1:8000"]

# ------------------------------------------------------------------------------
# 5. GIỚI HẠN TẦN SUẤT & NGHIỆP VỤ ĐIỂM NGẬP (RATE LIMITING & FLOOD RULES)
# ------------------------------------------------------------------------------
# Giới hạn số request/phút cho API Báo cáo ngập để chống spam (SRS 3.3.2)
RATE_LIMIT_PER_MINUTE=60

# Thời gian tự động hết hạn / hạ cấp điểm ngập (tính theo giờ) (SRS 3.2.3 FR3.3)
FLOOD_EXPIRATION_HOURS=24

# Tọa độ giới hạn viewport khu vực TP.HCM (Restrict Bounds - SRS 3.2.1 FR1.1)
# Vĩ độ: 10.37 đến 11.16 | Kinh độ: 106.35 đến 106.93
TPHCM_MIN_LAT=10.37
TPHCM_MAX_LAT=11.16
TPHCM_MIN_LNG=106.35
TPHCM_MAX_LNG=106.93

